<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Game display -->
    <FrameLayout
        android:id="@+id/gl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ── Toolbar (always visible) ────────────────────────────── -->
    <Button
        android:id="@+id/btn_load_rom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Load ROM"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:background="#88000000"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:minHeight="36dp" />

    <Button
        android:id="@+id/btn_link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Link: Off"
        android:layout_alignParentTop="true"
        android:layout_toLeftOf="@id/btn_upscaler"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:background="#88000000"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:minHeight="36dp" />

    <Button
        android:id="@+id/btn_upscaler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nearest"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="4dp"
        android:layout_marginRight="4dp"
        android:background="#88000000"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:minHeight="36dp" />

    <TextView
        android:id="@+id/txt_rom_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:visibility="gone"
        android:layout_alignParentTop="true"
        android:layout_alignParentLeft="true"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="8dp"
        android:textColor="#AAFFFFFF"
        android:textSize="10sp" />

    <!-- ── Touch controls (auto-hidden when gamepad detected) ── -->
    <FrameLayout
        android:id="@+id/touch_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- D-Pad -->
        <RelativeLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="24dp"
            android:layout_marginStart="24dp">

            <Button android:id="@+id/btn_up"    android:layout_width="46dp" android:layout_height="46dp" android:text="↑" android:layout_alignParentTop="true"    android:layout_centerHorizontal="true" android:background="#88FFFFFF" />
            <Button android:id="@+id/btn_down"  android:layout_width="46dp" android:layout_height="46dp" android:text="↓" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:background="#88FFFFFF" />
            <Button android:id="@+id/btn_left"  android:layout_width="46dp" android:layout_height="46dp" android:text="←" android:layout_centerVertical="true"    android:layout_alignParentLeft="true"  android:background="#88FFFFFF" />
            <Button android:id="@+id/btn_right" android:layout_width="46dp" android:layout_height="46dp" android:text="→" android:layout_centerVertical="true"    android:layout_alignParentRight="true" android:background="#88FFFFFF" />
        </RelativeLayout>

        <!-- A / B -->
        <RelativeLayout
            android:layout_width="110dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="40dp"
            android:layout_marginEnd="24dp">

            <Button android:id="@+id/btn_b" android:layout_width="46dp" android:layout_height="46dp" android:text="B" android:layout_alignParentBottom="true" android:layout_alignParentLeft="true"  android:background="#88FF0000" android:textColor="#FFF" />
            <Button android:id="@+id/btn_a" android:layout_width="46dp" android:layout_height="46dp" android:text="A" android:layout_alignParentTop="true"    android:layout_alignParentRight="true" android:background="#88FF0000" android:textColor="#FFF" />
        </RelativeLayout>

        <!-- L / R -->
        <Button android:id="@+id/btn_l" android:layout_width="70dp" android:layout_height="40dp" android:text="L"
            android:layout_gravity="top|start" android:layout_marginTop="4dp" android:layout_marginStart="4dp"
            android:background="#88FFFFFF" android:textSize="11sp" />
        <Button android:id="@+id/btn_r" android:layout_width="70dp" android:layout_height="40dp" android:text="R"
            android:layout_gravity="top|end" android:layout_marginTop="4dp" android:layout_marginEnd="4dp"
            android:background="#88FFFFFF" android:textSize="11sp" />

        <!-- Select / Start -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btn_select" android:layout_width="60dp" android:layout_height="34dp" android:text="SEL"   android:textSize="10sp" android:layout_marginRight="10dp" android:background="#88FFFFFF" />
            <Button android:id="@+id/btn_start"  android:layout_width="60dp" android:layout_height="34dp" android:text="START" android:textSize="10sp" android:layout_marginLeft="10dp"  android:background="#88FFFFFF" />
        </LinearLayout>

    </FrameLayout>

</RelativeLayout>
