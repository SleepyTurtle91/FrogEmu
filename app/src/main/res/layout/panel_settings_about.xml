<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🐸 FroggBA Handheld Emulator"
        android:textColor="#00FF66"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Version 1.0 • Built for Anbernic RG556 Handheld Console\nDeveloped by LemonSquad • GitHub: SleepyTurtle91/FroggBA"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Emulation Core Engine"
        android:textColor="#00FF66"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="mGBA Core Engine v0.11-dev (Mozilla Public License 2.0)\nCopyright (c) 2013-2024 Jeffrey Pfau and contributors.\nHigh-accuracy cycle-accurate ARM7TDMI &amp; GBA SIO emulation."
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Source Licenses &amp; Third-Party Notices"
        android:textColor="#00FF66"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#22000000"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• mGBA: Mozilla Public License 2.0 (MPL-2.0)\n• AndroidX &amp; Material Components: Apache License 2.0\n• zlib / libpng / lzma: zlib / libpng / BSD Licenses"
            android:textColor="#888888"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
