<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🐸 FrogEmu"
        android:textColor="#00FF66"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Multi-System Handheld Emulator for Android\nPowered by mGBA Core Engine • GitHub: SleepyTurtle91/FrogEmu"
        android:textColor="#CCCCCC"
        android:textSize="12sp"
        android:layout_marginBottom="10dp" />

    <!-- ── Current Systems & Engine ───────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Active Features (Current)"
        android:textColor="#00FF66"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 Game Boy Advance (GBA) via mGBA Engine\n🟢 Physical Anbernic RG556 Controller &amp; Touch Overlay\n🟢 16-bit PCM Audio Output (32.7 kHz)\n🟢 Modular OpenGL ES Shader Pipeline (Nearest &amp; Scale2x)\n🟢 Battery SRAM Save Persistence\n🟢 Built-in Link SIO Adapter &amp; Loopback Transport"
        android:textColor="#DDDDDD"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="10dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="4dp" />

    <!-- ── Future Roadmap ────────────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Planned Roadmap (Future / Experimental)"
        android:textColor="#00DDFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔵 Systems: Game Boy (GB), Game Boy Color (GBC), PS1, PSP\n🔵 Graphics: Vulkan Renderer Backend, Scanlines, CRT, LCD Grid, HQ2x, xBRZ\n🔵 Connectivity: On-Demand Wi-Fi LAN, Hotspot &amp; Bluetooth Multiplayer\n🔵 Tools: Save-State Snapshots, Cheats Engine (cheats.db), ROM Library"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="10dp" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="4dp" />

    <!-- ── Open Source Licenses ──────────────────────────────── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Source Licenses &amp; Third-Party Notices"
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#22000000"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• mGBA Core: Mozilla Public License 2.0 (MPL-2.0)\n  Copyright (c) 2013-2024 Jeffrey Pfau &amp; contributors\n• AndroidX &amp; Material Components: Apache License 2.0\n• zlib / libpng / lzma: zlib / libpng / BSD Licenses"
            android:textColor="#888888"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="* FrogEmu is an evolving project. Roadmap goals represent architectural milestones."
        android:textColor="#666666"
        android:textSize="10sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
