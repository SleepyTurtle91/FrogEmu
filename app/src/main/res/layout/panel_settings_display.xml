<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Scaling &amp; Shaders"
        android:textColor="#00FF66"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/rg_upscaler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_upscaler_nearest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nearest (Pixel-Perfect 1:1 Reference Baseline)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <RadioButton
            android:id="@+id/rb_upscaler_scale2x"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scale2x (Sub-pixel Retro Edge Scaling)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />
    </RadioGroup>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22FFFFFF" android:layout_marginVertical="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Geometry &amp; Viewport"
        android:textColor="#00FF66"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/chk_integer_scaling"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Maintain Strict 3:2 Aspect Ratio on RG556 OLED"
        android:textColor="#FFFFFF"
        android:checked="true"
        android:textSize="13sp" />

</LinearLayout>
